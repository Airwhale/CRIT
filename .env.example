# Required: Get your Steam API key from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Required: Your Steam 64-bit user ID (find it at https://steamid.io)
STEAM_USER_ID=your_steam_user_id_here

# Required: Get a free RAWG API key from https://rawg.io/apidocs
RAWG_API_KEY=your_rawg_api_key_here

# Required: Get your Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Get a free ITAD API key at https://isthereanydeal.com/dev/app/
# Enables historical low prices and price history charts in the deals table and library
ITAD_API_KEY=
